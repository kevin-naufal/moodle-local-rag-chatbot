# Demo evaluation defaults.
DEMO_EVAL_DATASET=.\data\answer_run_questions\ch03_running_time_in_scope_30q.json
DEMO_EVAL_DATA_DIR=.\data\eval_ch03_only
DEMO_EVAL_RUNS=1
DEMO_EVAL_MODES=llm_only,rag_ollama,rag_bert
DEMO_EVAL_USE_EXISTING_ANSWER_RUNS=false
DEMO_EVAL_EXISTING_ANSWER_RUNS=
DEMO_EVAL_REUSE_JUDGED_RUNS_FROM=

# Ollama / model runtime.
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_NUM_PREDICT=1024

# Embedding backend.
# EMBED_BACKEND can be: auto, ollama, or bert.
EMBED_BACKEND=auto
EMBED_MODEL=nomic-embed-text
BERT_MODEL=sentence-transformers/msmarco-bert-base-dot-v5
BERT_MAX_LENGTH=512
BERT_BATCH_SIZE=8

# Logging / tracing.
TRACE_TEXT_MAX_CHARS=12000
