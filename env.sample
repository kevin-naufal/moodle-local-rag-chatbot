# Demo evaluation defaults.
DEMO_EVAL_PROFILE=dev
DEMO_EVAL_DEV_DATASET=.\data\answer_run_questions\ch03_running_time_in_scope_3q.json
DEMO_EVAL_DATASET=.\data\answer_run_questions\ch03_running_time_in_scope_40q.json
DEMO_EVAL_DATA_DIR=.\data\eval_ch03_only
DEMO_EVAL_RUNS=1
DEMO_EVAL_MODES=llm_only,rag_ollama,rag_bert,rag_msmarco
DEMO_EVAL_USE_EXISTING_ANSWER_RUNS=false
DEMO_EVAL_FORCE_NEW_ANSWER_RUNS=false
DEMO_EVAL_EXISTING_ANSWER_RUNS=
DEMO_EVAL_REUSE_JUDGED_RUNS_FROM=

# Ollama / model runtime.
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_NUM_PREDICT=1024

# Embedding backend.
# EMBED_BACKEND can be: auto, ollama, or bert.
EMBED_BACKEND=auto
EMBED_MODEL=nomic-embed-text
BERT_MODEL=bert-base-uncased
BERT_MAX_LENGTH=512
BERT_BATCH_SIZE=8

# RAG retrieval / chunking.
RAG_TOP_K=6
RAG_CANDIDATE_K=12
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Logging / tracing.
TRACE_TEXT_MAX_CHARS=12000

# Answer-quality evaluation.
QUALITY_EVAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
