{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.chatbot/schemas/essay_autograde_output_v1.json",
  "title": "Essay Auto-Grading Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rubric_id",
    "question_number",
    "overall_score",
    "max_score",
    "criterion_scores",
    "strengths",
    "improvement_suggestions",
    "missing_key_points",
    "flags",
    "confidence"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "essay_autograde_output_v1"
    },
    "rubric_id": {
      "type": "string",
      "minLength": 1
    },
    "question_number": {
      "type": "integer",
      "minimum": 1
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "max_score": {
      "type": "number",
      "const": 100
    },
    "criterion_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_key",
          "weight",
          "level",
          "score",
          "reason"
        ],
        "properties": {
          "criterion_key": {
            "type": "string",
            "enum": [
              "content_accuracy",
              "coverage_of_key_points",
              "reasoning_quality",
              "organization_clarity",
              "language_mechanics"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 5
    },
    "improvement_suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 5
    },
    "missing_key_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 10
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs_manual_review",
        "reasons"
      ],
      "properties": {
        "needs_manual_review": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 5
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "grader_notes": {
      "type": "string",
      "maxLength": 1000
    }
  }
}