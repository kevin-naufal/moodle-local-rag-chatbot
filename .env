# File soal evaluasi
DEMO_EVAL_DATASET=.\data\answer_run_questions\ch03_running_time_in_scope_40q.json

# Folder dokumen sumber RAG
DEMO_EVAL_DATA_DIR=.\data\eval_ch03_only

# Jumlah run per mode
DEMO_EVAL_RUNS=3

# Mode yang diuji
DEMO_EVAL_MODES=llm_only,rag_ollama,rag_bert,rag_msmarco

# Pakai file jawaban yang sudah ada, tanpa generate ulang
DEMO_EVAL_USE_EXISTING_ANSWER_RUNS=true

# File jawaban existing yang dipakai untuk evaluasi
DEMO_EVAL_EXISTING_ANSWER_RUNS=.\data\answer_runs\answer_runs_ch03_40q_4modes_3runs.jsonl

################################################################
################################################################

# URL Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Panjang maksimum jawaban model
CHAT_NUM_PREDICT=2048

# Default backend embedding
EMBED_BACKEND=auto

# Model BERT embedding
BERT_MODEL=sentence-transformers/msmarco-bert-base-dot-v5

# Panjang input maksimum untuk BERT
BERT_MAX_LENGTH=256

# Batch size untuk BERT
BERT_BATCH_SIZE=16

# Batas panjang teks di log
TRACE_TEXT_MAX_CHARS=8000
